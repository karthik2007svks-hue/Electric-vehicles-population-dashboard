# --- MOCK DATA GENERATION (Simulating a real dataset) ---
@st.cache_data
def load_data():
    # Data Estimates based on 2024-2025 Research (Vahan, State Transport Depts)
    # Note: Precise city-level live counts are estimates derived from state data & market trends.
    data = {
        'City': ['Bengaluru', 'New Delhi', 'Mumbai', 'Chennai',
                 'Hyderabad', 'Kolkata', 'Ahmedabad', 'Pune'],
        'EV_Count': [155000, 220000, 95000, 85000,
                     72000, 45000, 38000, 110000], 
        'Avg_Range': [185, 180, 175, 190,
                      188, 170, 182, 178], # Avg real-world range considering traffic/climate
        'BEV_Share': [0.92, 0.88, 0.90, 0.93,
                      0.91, 0.85, 0.89, 0.94], # Dominance of BEV 2W/3W/4W
        'Public_Chargers': [3200, 4500, 1500, 1100,
                            950, 450, 600, 1200], # Public charging points
        'Growth_Rate': [45, 18, 55, 30,
                        35, 25, 40, 50], # 2024-25 YoY Growth estimates
        'Safety_Index': [8.2, 5.8, 7.5, 7.9,
                         7.6, 6.2, 7.1, 7.4] # Calculated proxy based on Infra/Density/Climate risk
    }
    
    df = pd.DataFrame(data)
    
    # Real-world Fuel Mix Estimates (approximate % share in fleet)
    # Delhi/Gujarat have high CNG. South/West have high Petrol/Diesel.
    # Logic: EV Count is ~2-6% of total. We extrapolate total fleet from EV count & penetration, then apply mix.
    
    # Mix Defaults (Petrol, Diesel, CNG)
    mix_map = {
        'New Delhi': [0.45, 0.18, 0.32], # High CNG
        'Ahmedabad': [0.35, 0.25, 0.38], # High CNG
        'Mumbai':    [0.36, 0.20, 0.36], # Mix
        'Bengaluru': [0.62, 0.17, 0.12], # High Petrol
        'Pune':      [0.55, 0.30, 0.08],
        'Chennai':   [0.58, 0.30, 0.05],
        'Hyderabad': [0.55, 0.35, 0.05],
        'Kolkata':   [0.40, 0.45, 0.05]  # High Diesel
    }

    p_list, d_list, c_list = [], [], []
    
    for i, row in df.iterrows():
        city = row['City']
        ev_c = row['EV_Count']
        # Assume EV is approx 3-5% of active fleet to find Total
        total_fleet = ev_c * 25 
        
        mix = mix_map.get(city, [0.5, 0.3, 0.1])
        p_list.append(int(total_fleet * mix[0]))
        d_list.append(int(total_fleet * mix[1]))
        c_list.append(int(total_fleet * mix[2]))

    df['Petrol_Count'] = p_list
    df['Diesel_Count'] = d_list
    df['CNG_Count'] = c_list
    df['EV_New_Registrations'] = (df['EV_Count'] * (df['Growth_Rate'] / 100)).astype(int)
    return df

