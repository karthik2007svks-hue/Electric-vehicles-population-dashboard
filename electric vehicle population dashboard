st.divider()
st.subheader("🔮 Predictive & What-If Analysis")
st.info(f"Scenario: {years_forecast}-Year Projection with {growth_multiplier}x Growth Rate & +{new_chargers} Chargers")

sim_df = filtered_df.copy()
# Calculate Future EV Counts (Compound Annual Growth)
sim_df['Future_EV_Count'] = (sim_df['EV_Count'] * ((1 + (sim_df['Growth_Rate'] * growth_multiplier)/100) ** years_forecast)).astype(int)
sim_df['Projected_Increase'] = sim_df['Future_EV_Count'] - sim_df['EV_Count']

# Calculate Future Charger Ratio
total_current_chargers = sim_df['Public_Chargers'].sum()
total_future_chargers = total_current_chargers + new_chargers
total_future_evs = sim_df['Future_EV_Count'].sum()
future_ratio = int(total_future_evs / total_future_chargers) if total_future_chargers > 0 else 0

# CO2 Savings (Approx 2.5 tons per EV per year)
co2_savings = (sim_df['Future_EV_Count'].sum() * 2.5 * years_forecast) / 1000 # in Kilotons

scen_col1, scen_col2 = st.columns([2, 1])

with scen_col1:
    # Comparison Chart
    fig_sim = go.Figure()
    fig_sim.add_trace(go.Bar(x=sim_df['City'], y=sim_df['EV_Count'], name='Current EVs', marker_color='#1f77b4'))
    fig_sim.add_trace(go.Bar(x=sim_df['City'], y=sim_df['Projected_Increase'], name=f'+{years_forecast}yr Growth', marker_color='#2ca02c'))
    fig_sim.update_layout(title=f"Projected EV Fleet Size ({years_forecast} Years)", barmode='stack')
    st.plotly_chart(fig_sim, use_container_width=True)

with scen_col2:
    st.markdown("#### Impact Analysis")
    st.metric(f"Projected Total EVs (Year {years_forecast})", f"{total_future_evs:,}", f"+{sim_df['Projected_Increase'].sum():,}")
    
    ratio_delta = future_ratio - int(sim_df['EV_Count'].sum() / sim_df['Public_Chargers'].sum())
    st.metric("Projected Charger Ratio (1:N)", f"1:{future_ratio}", f"{ratio_delta} vehicles/charger", delta_color="inverse")
    
    st.metric("Est. CO2 Emissions Avoided", f"{co2_savings:,.1f} kt", help="Based on 2.5 tons saved per EV/year")
    
    if future_ratio > 15:
        st.warning(f"⚠️ Infrastructure Gap: Ratio of 1:{future_ratio} is critical. Add {int(total_future_evs/15 - total_future_chargers):,} more chargers.")
    else:
        st.success("✅ Sustainable Infrastructure Growth maintained.")

# Gap Analysis Chart (New Forecast)
st.markdown("#### 📉 Infrastructure Gap Forecast")
trend_data = []
current_evs = filtered_df['EV_Count'].sum()
current_chargers = filtered_df['Public_Chargers'].sum()

for y in range(years_forecast + 1):
    ev_proj = current_evs * ((1 + (filtered_df['Growth_Rate'].mean() * growth_multiplier)/100) ** y)
    req_chargers = ev_proj / 15 # Target 1:15 ratio
    # Assumed organic infrastructure growth of 20%
    planned_chargers = current_chargers * ((1 + 0.20) ** y) + (new_chargers if y > 0 else 0)
    
    trend_data.append({
        "Year": f"Year {y}",
        "Required Chargers": int(req_chargers),
        "Planned Chargers": int(planned_chargers),
        "Gap": int(req_chargers - planned_chargers)
    })

trend_df = pd.DataFrame(trend_data)
fig_gap_trend = px.line(trend_df, x="Year", y=["Required Chargers", "Planned Chargers"], markers=True,
                        title="Projected Charger Demand vs Supply (Gap Analysis)",
                        color_discrete_map={"Required Chargers": "red", "Planned Chargers": "green"})
st.plotly_chart(fig_gap_trend, use_container_width=True)
st.caption("Red line vs Green line divergence indicates the widening infrastructure gap if no intervention occurs.")

